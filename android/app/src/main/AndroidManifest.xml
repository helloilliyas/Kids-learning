<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network is used only to reach the private backend over HTTPS. No other
         data leaves the device; child data stays local by default. -->
    <!-- No CAMERA permission: photos are taken via the system camera app
         (ACTION_IMAGE_CAPTURE), which requires none from us — and declaring it
         unused would actually break that intent on some devices. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic allows plain-http backends during local testing on a
         home network (e.g. http://192.168.x.x:8000). Production backends use HTTPS. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KidsLearning">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KidsLearning">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants the system camera app a place to write full-resolution
             captures (cache/camera/). TakePicturePreview only returned a small
             preview bitmap, which made photographed pages blurry. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
