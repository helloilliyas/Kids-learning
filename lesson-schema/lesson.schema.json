{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.local/schemas/lesson.schema.json",
  "title": "Lesson",
  "description": "A complete interactive lesson. Generated by the backend, rendered by the Android app. Schema version 1.0 supports the six V1 activity types plus explanation cards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "title",
    "subject",
    "language",
    "age",
    "difficulty",
    "learning_objectives",
    "concepts",
    "sections",
    "completion_message"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Schema version this lesson conforms to. Stored with every lesson so future app versions can migrate or refuse gracefully."
    },
    "lesson_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "BCP-47 style language tag, e.g. 'en' or 'en-GB'."
    },
    "age": {
      "type": "integer",
      "minimum": 3,
      "maximum": 18
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimated_duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Concepts taught in this lesson. Activities reference these by concept_id; mastery is tracked per concept.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "name"
        ],
        "properties": {
          "concept_id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "description": "Uploaded sources this lesson was generated from. Empty for lessons generated purely from a typed topic.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "completion_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Lowercase identifier: letters, digits, underscore, hyphen."
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis"
      ],
      "description": "Where this content came from, so the parent can verify it against the source.",
      "properties": {
        "basis": {
          "enum": [
            "source_explicit",
            "general_knowledge",
            "interpretation"
          ],
          "description": "source_explicit: stated in the uploaded material. general_knowledge: standard educational fact not in the source. interpretation: reasoned from the source but not stated."
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "sectionBase": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "concept_id": {
          "$ref": "#/$defs/id"
        },
        "difficulty_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Position on the lesson's difficulty progression. Extensions continue from the highest level the child has mastered."
        },
        "emoji": {
          "type": "string",
          "maxLength": 16,
          "description": "Optional emoji displayed large above this section -- the offline visual anchor for the concept (e.g. ☀️ for evaporation)."
        },
        "image_ref": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based index into the source images uploaded with the generation request. When set, the app shows the child that actual photo/scan/PDF page with this section. Must reference an image that was really provided."
        },
        "grounding": {
          "$ref": "#/$defs/grounding"
        },
        "image_search": {
          "type": "string",
          "maxLength": 60,
          "description": "Concrete noun phrase matching a Wikipedia article title (e.g. 'Jupiter', 'Bengal tiger'). At generation time the app fetches that article's lead photo and attaches it to this section — use it to SHOW real things (planets, animals, landmarks) when no uploaded image covers them."
        }
      }
    },
    "activityFeedback": {
      "type": "object",
      "required": [
        "hint",
        "correct_feedback",
        "incorrect_feedback"
      ],
      "properties": {
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "correct_feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "incorrect_feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Must teach toward the right idea, not just say 'try again'."
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "emoji": {
          "type": "string",
          "maxLength": 16,
          "description": "Optional emoji shown large next to the option text -- the offline 'picture' for this choice."
        }
      }
    },
    "section": {
      "oneOf": [
        {
          "$ref": "#/$defs/explanation"
        },
        {
          "$ref": "#/$defs/animatedStory"
        },
        {
          "$ref": "#/$defs/chart"
        },
        {
          "$ref": "#/$defs/multipleChoice"
        },
        {
          "$ref": "#/$defs/trueFalse"
        },
        {
          "$ref": "#/$defs/fillInTheBlank"
        },
        {
          "$ref": "#/$defs/matchPairs"
        },
        {
          "$ref": "#/$defs/dragIntoOrder"
        },
        {
          "$ref": "#/$defs/buildBarChart"
        },
        {
          "$ref": "#/$defs/tapImage"
        },
        {
          "$ref": "#/$defs/sortIntoCategories"
        },
        {
          "$ref": "#/$defs/numberLine"
        }
      ]
    },
    "chartItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "emoji": {
          "type": "string",
          "maxLength": 16
        }
      }
    },
    "chart": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "title",
        "chart_type",
        "items"
      ],
      "description": "A data visual the app renders natively (no image needed): a colourful bar chart or an emoji pictograph. Prefer recreating a graph from the source as a chart over attaching its photo.",
      "properties": {
        "type": {
          "const": "chart"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "chart_type": {
          "enum": [
            "bar",
            "pictograph"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/chartItem"
          }
        },
        "unit": {
          "type": "string",
          "maxLength": 30,
          "description": "What the values count, e.g. 'muffins'."
        },
        "symbol_value": {
          "type": "integer",
          "minimum": 1,
          "description": "Pictograph key: one symbol equals this many. Item emojis are the symbols."
        }
      }
    },
    "buildBarChart": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "instruction",
        "items",
        "max_value"
      ],
      "description": "Interactive graphing: the child drags each bar to the target height (like completing a bar graph in a workbook).",
      "properties": {
        "type": {
          "const": "build_bar_chart"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "target"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "target": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "emoji": {
                "type": "string",
                "maxLength": 16
              }
            }
          }
        },
        "max_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Top of the axis; every target must fit within it."
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "explanation": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "title",
        "content"
      ],
      "properties": {
        "type": {
          "const": "explanation"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "image_description": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional description of an illustration for this card. V1 renders it as a caption placeholder; later versions may generate or fetch an image."
        }
      }
    },
    "animatedStory": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "title",
        "scenes"
      ],
      "description": "An auto-playing animated intro: a sequence of short narrated scenes the app plays with animations, voice narration, and sound effects. Every lesson should OPEN with one, telling the concept as a tiny story before any questions.",
      "properties": {
        "type": {
          "const": "animated_story"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scenes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "One or two short sentences, narrated aloud while the scene shows."
              },
              "emoji": {
                "type": "string",
                "maxLength": 16,
                "description": "Big animated emoji for this scene (the visual when there is no photo)."
              },
              "image_ref": {
                "type": "integer",
                "minimum": 0
              },
              "image_search": {
                "type": "string",
                "maxLength": 60,
                "description": "Wikipedia article title to fetch a real photo for this scene."
              }
            }
          }
        }
      }
    },
    "multipleChoice": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "question",
        "options",
        "correct_answer_ids",
        "selection_mode"
      ],
      "properties": {
        "type": {
          "const": "multiple_choice"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "selection_mode": {
          "enum": [
            "single",
            "multiple"
          ],
          "description": "single renders as tap-one; multiple renders as select-all-that-apply."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correct_answer_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "trueFalse": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "statement",
        "correct_answer"
      ],
      "properties": {
        "type": {
          "const": "true_false"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "correct_answer": {
          "type": "boolean"
        }
      }
    },
    "fillInTheBlank": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "template",
        "blanks"
      ],
      "properties": {
        "type": {
          "const": "fill_in_the_blank"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Sentence containing one {{blank_id}} marker per blank, e.g. 'Water turns into {{b1}} when heated.'"
        },
        "blanks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "accepted_answers"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "accepted_answers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "case_sensitive": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "word_bank": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "Optional tap-to-fill word choices (correct answers plus distractors). Required for ages 6 and under, where typing is not appropriate."
        }
      }
    },
    "matchPairs": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "instruction",
        "pairs"
      ],
      "properties": {
        "type": {
          "const": "match_pairs"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/option"
              },
              "right": {
                "$ref": "#/$defs/option"
              }
            }
          }
        }
      }
    },
    "dragIntoOrder": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "instruction",
        "items",
        "correct_order"
      ],
      "properties": {
        "type": {
          "const": "drag_into_order"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correct_order": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Item ids in the correct sequence. Must be an exact permutation of items."
        }
      }
    },
    "tapImage": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "question",
        "options",
        "correct_option_id"
      ],
      "description": "Tap the correct picture. Options can carry image_search (real photo), emoji, or a label — provide emoji as fallback in case a photo cannot be fetched.",
      "properties": {
        "type": {
          "const": "tap_image"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "emoji": {
                "type": "string",
                "maxLength": 16
              },
              "image_search": {
                "type": "string",
                "maxLength": 60
              },
              "image_ref": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "correct_option_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "sortIntoCategories": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "instruction",
        "categories",
        "items"
      ],
      "description": "Sort items into labelled buckets (living/non-living, nouns/verbs, inner/outer planets ...). Works for nearly every subject.",
      "properties": {
        "type": {
          "const": "sort_into_categories"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "emoji": {
                "type": "string",
                "maxLength": 16
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "category_id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "emoji": {
                "type": "string",
                "maxLength": 16
              },
              "category_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "numberLine": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "$ref": "#/$defs/activityFeedback"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "question",
        "min_value",
        "max_value",
        "correct_value"
      ],
      "description": "The child slides a marker along a number line to the answer.",
      "properties": {
        "type": {
          "const": "number_line"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "min_value": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "max_value": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "correct_value": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "unit": {
          "type": "string",
          "maxLength": 30
        }
      }
    }
  }
}
